# Copiar a backend/.env y ajustar. Todas las variables llevan el prefijo PROSTA_.
# Las rutas relativas se resuelven desde la carpeta backend/.
PROSTA_DATABASE_URL=postgresql+psycopg://prosta@localhost:5433/prosta_ai
PROSTA_STORAGE_DIR=../almacenamiento
# Clave para firmar el token de acceso: poner una larga y aleatoria
PROSTA_SECRET_KEY=cambiar-esta-clave-en-desarrollo
PROSTA_TOKEN_HORAS=8
PROSTA_MAX_UPLOAD_MB=50
PROSTA_MAX_ESTUDIO_MB=150
PROSTA_MODELO_NOMBRE=prostate_mri_anatomy
PROSTA_MODELO_DIR=../modelos
PROSTA_CORS_ORIGINS=http://localhost:5173
